#!/bin/bash
set -e

prebuild=true

normalize_dotnet_version() {
  local value="$1"
  local base="${value%%+*}"

  if [[ "$base" =~ ^([0-9]{8,10})-slskdn\.([0-9]+)$ ]]; then
    printf '0.0.0-slskdn.%s.%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
  elif [[ "$base" =~ ^slskdn\.([0-9]+)$ ]]; then
    printf '0.0.0-slskdn.%s\n' "${BASH_REMATCH[1]}"
  else
    printf '%s\n' "${base//.dev./-dev-}"
  fi
}

while test $# -gt 0; do
  case "$1" in
    -h|--help)
      echo 'options:'
      echo '-h, --help          show help'
      echo '--no-prebuild       skip build and test'
      echo '--runtime           a valid RID (https://docs.microsoft.com/en-us/dotnet/core/rid-catalog)'
      echo '--platform          one of: linux/amd64, linux/arm64, linux/arm/v7.  overrides runtime.'
      echo '--version           version for the binary. defaults to current git tag+SHA'
      echo '--output            the output directory.  defaults to ../../dist/<runtime>'
      exit 0
      ;;
    --no-prebuild)
      prebuild=false
      shift
      ;;
    --runtime*)
      shift
      runtime=$1
      shift
      ;;
    --platform*)
      shift
      platform=$1
      shift
      ;;
    --version)
      shift
      version=$1
      shift
      ;;
    --output)
      shift
      output=$1
      shift
      ;;
    *)
      break
      ;;
  esac
done

if [ ! -z "$platform" ]; then
  case "$platform" in
    linux/amd64)
      runtime="linux-x64"
      ;;
    linux/arm64)
      runtime="linux-arm64"
      ;;
    linux/arm/v7)
      runtime="linux-arm"
      ;;
    *)
      echo "💥  error: platform must be one of: linux/amd64, linux/arm64, linux/arm/v7"
      exit 1
      ;;
  esac

  echo $'\n\tℹ️  runtime overridden by platform option '$platform$', using '$runtime$'\n'
fi


if [ -z "$version" ]; then 
  tag=$(git describe --tags --abbrev=0)
  sha=$(git rev-parse --short HEAD)
  version=$tag+$sha
fi

public_version=$version
dotnet_version=$(normalize_dotnet_version "$public_version")

if [ -z "$runtime" ]; then
    echo "💥  error: no runtime specified; provide a valid RID (https://docs.microsoft.com/en-us/dotnet/core/rid-catalog)"
    exit 1
fi

if [ -z "$output" ]; then
  output=$'../../dist/'$runtime
fi

if [ "$prebuild" == true ]; then
    echo $'\n\t🛠️  bin/build --version '$public_version$'\n'
    bin/build --version "$public_version"
else
    echo $'\n\t⏩  pre-build skipped\n'
fi

cd src/slskd
echo $'\n\t📍  '$(pwd)$'\n'

echo $'\n\t🛠️  dotnet publish ... --runtime '$runtime$' -p:Version '$dotnet_version$' -p:InformationalVersion '$public_version$' --output '$output$'\n'
rm -rf "$output"
mkdir -p "$output"

dotnet publish \
    --configuration Release \
    -p:PublishReadyToRun=false \
    -p:CopyOutputSymbolsToPublishDirectory=false \
    -p:Version="$dotnet_version" \
    -p:InformationalVersion="$public_version" \
    -p:AllowMissingPrunePackageData=true \
    --self-contained \
    --runtime $runtime \
    --output $output

echo $'\n\t🛠️  dotnet publish slskdN-vpn-agent ... --runtime '$runtime$' --output '$output/vpn-agent$'\n'
dotnet publish ../../src/slskdN.VpnAgent/slskdN-vpn-agent.csproj \
    --configuration Release \
    -p:PublishSingleFile=true \
    -p:Version="$dotnet_version" \
    -p:InformationalVersion="$public_version" \
    -p:PackageVersion="$dotnet_version" \
    --self-contained \
    --runtime "$runtime" \
    --output "$output/vpn-agent"
cp ../../src/slskdN.VpnAgent/README.md "$output/vpn-agent/README.md"
cp ../../src/slskdN.VpnAgent/windows-macos.md "$output/vpn-agent/windows-macos.md"
case "$runtime" in
  linux-*)
    cp -r ../../src/slskdN.VpnAgent/systemd "$output/vpn-agent/"
    cp ../../src/slskdN.VpnAgent/install.sh "$output/vpn-agent/install.sh"
    chmod +x "$output/vpn-agent/slskdN-vpn-agent" "$output/vpn-agent/install.sh"
    ;;
esac

cd $output
echo $'\n\t📍  '$(pwd)$'\n'

echo $'\n\t📦  artifacts:\n'
ls -la .

echo $'\n\t🎉  publish succeeded!\n'
