#!/bin/bash
set -e

dotnet test --verbosity minimal --no-build --configuration Release --blame -p:CollectCoverage=true -p:CoverletOutput="../coverage.json" tests/Soulseek.Tests.Unit -p:Include="[Soulseek]*"

if [ -n "${SLSK_INTEGRATION_USERNAME:-}" ] && [ -n "${SLSK_INTEGRATION_PASSWORD:-}" ]; then
    if [ -n "${SLSK_INTEGRATION_PEER_USERNAME:-}" ] && [ -n "${SLSK_INTEGRATION_PEER_PASSWORD:-}" ]; then
        dotnet test --verbosity minimal --no-build --configuration Release --blame -p:CollectCoverage=true -p:MergeWith="../coverage.json" -p:CoverletOutput="../coverage.integration.json" tests/Soulseek.Tests.Integration --filter "Category!=PeerConnectivity" -p:Include="[Soulseek]*"
        dotnet test --verbosity minimal --no-build --configuration Release --blame -p:CollectCoverage=true -p:MergeWith="../coverage.integration.json" -p:CoverletOutput="../opencover.xml" -p:CoverletOutputFormat=opencover tests/Soulseek.Tests.Integration --filter "Category=PeerConnectivity" -p:Include="[Soulseek]*"
    else
        dotnet test --verbosity minimal --no-build --configuration Release --blame -p:CollectCoverage=true -p:MergeWith="../coverage.json" -p:CoverletOutput="../opencover.xml" -p:CoverletOutputFormat=opencover tests/Soulseek.Tests.Integration --filter "Category!=PeerConnectivity" -p:Include="[Soulseek]*"
        echo "Skipping peer-to-peer live Soulseek integration tests; set SLSK_INTEGRATION_PEER_USERNAME and SLSK_INTEGRATION_PEER_PASSWORD to enable them."
    fi
else
    echo "Skipping live Soulseek integration tests; set SLSK_INTEGRATION_USERNAME and SLSK_INTEGRATION_PASSWORD to enable them."
    dotnet test --verbosity minimal --no-build --configuration Release --blame -p:CollectCoverage=true -p:MergeWith="../coverage.json" -p:CoverletOutput="../opencover.xml" -p:CoverletOutputFormat=opencover tests/Soulseek.Tests.Integration --filter "Category!=Connectivity" -p:Include="[Soulseek]*"
fi
