#!/bin/bash
set -e
dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

github_repository="${GITHUB_REPOSITORY:-snapetech/slskNet.Runtime}"
sonar_project_key="${SONAR_PROJECT_KEY:-snapetech_slskNet.Runtime}"
sonar_organization="${SONAR_ORGANIZATION:-snapetech}"
sonar_token="${TOKEN_SONARCLOUD:-${SONAR_TOKEN:-}}"
codecov_token="${TOKEN_CODECOV_SLSKNET_RUNTIME:-${TOKEN_CODECOV_SOULSEEKNET:-${CODECOV_TOKEN:-}}}"

# get the current git branch and set options for a non-PR analysis
branch=$(git rev-parse --abbrev-ref HEAD)
options="/d:sonar.branch.name="${branch}""

# if running in CircleCI, use the provided environment variables to set analysis options
if [ ! -z "${CIRCLECI}" ]; then
    branch="${CIRCLE_BRANCH}"
    options="/d:sonar.branch.name="${branch}""

    # if building a PR, fetch the PR info from GitHub to determine the base and branch, then set options for PR analysis
    if [ ! -z "${CIRCLE_PULL_REQUEST}" ]; then
        echo "Fetching PR to determine base and branch"
        pr_json="$(curl -s "https://api.github.com/repos/${github_repository}/pulls/${CIRCLE_PULL_REQUEST##*/}")"
        base="$(echo "${pr_json}" | jq -r ".base.ref")"
        branch="$(echo "${pr_json}" | jq -r ".head.ref")"
        options="/d:sonar.pullrequest.base="${base}" /d:sonar.pullrequest.branch="${branch}" /d:sonar.pullrequest.key="${CIRCLE_PULL_REQUEST##*/}""
    fi
fi

# disable git bash/mingw path mangling on Windows
export MSYS2_ARG_CONV_EXCL="*"

if [ -n "${sonar_token}" ]; then
    echo "Launching dotnet-sonarscanner for ${github_repository} with options: ${options}"

    dotnet-sonarscanner begin \
        /key:"${sonar_project_key}" \
        /o:"${sonar_organization}" \
        ${options} \
        /d:sonar.host.url="https://sonarcloud.io" \
        /d:sonar.github.repository="${github_repository}" \
        /d:sonar.exclusions="**/*examples*/**" \
        /d:sonar.cs.opencover.reportsPaths="tests/opencover.xml" \
        /d:sonar.login="${sonar_token}"
else
    echo "Skipping SonarCloud analysis; set TOKEN_SONARCLOUD or SONAR_TOKEN to enable it."
fi

. "${dir}/build"
. "${dir}/test"

if [ -n "${sonar_token}" ]; then
    dotnet-sonarscanner end /d:sonar.login="${sonar_token}"
fi

if [ -n "${codecov_token}" ]; then
    bash <(curl -s https://codecov.io/bash) -f tests/opencover.xml -t "${codecov_token}"
else
    echo "Skipping Codecov upload; set TOKEN_CODECOV_SLSKNET_RUNTIME, TOKEN_CODECOV_SOULSEEKNET, or CODECOV_TOKEN to enable it."
fi
