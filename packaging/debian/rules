#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	# Binary is pre-built, skip build

override_dh_auto_install:
	# Install application
	install -dm755 debian/slskdn/usr/lib/slskd
	cp -r usr/lib/slskd/* debian/slskdn/usr/lib/slskd/
	chmod +x debian/slskdn/usr/lib/slskd/slskd
	# Match the Nix package fix when the bundled runtime includes the trace provider library.
	tracept_provider=$$(find debian/slskdn/usr/lib/slskd -name libcoreclrtraceptprovider.so -print -quit); \
	if [ -n "$$tracept_provider" ]; then \
		patchelf --replace-needed liblttng-ust.so.0 liblttng-ust.so.1 "$$tracept_provider"; \
	else \
		echo "libcoreclrtraceptprovider.so not present in staged DEB payload; skipping SONAME patch"; \
	fi
	
	# Create symlink
	install -dm755 debian/slskdn/usr/bin
	ln -sf /usr/lib/slskd/slskd debian/slskdn/usr/bin/slskd
	
	# Install systemd service
	install -Dm644 lib/systemd/system/slskd.service debian/slskdn/lib/systemd/system/slskd.service
	if [ -x usr/lib/slskd/vpn-agent/slskdN-vpn-agent ]; then \
		install -Dm755 usr/lib/slskd/vpn-agent/slskdN-vpn-agent debian/slskdn/usr/bin/slskdN-vpn-agent; \
		install -Dm644 usr/lib/slskd/vpn-agent/systemd/slskdN-vpn-split.service debian/slskdn/lib/systemd/system/slskdN-vpn-split.service; \
		install -Dm644 usr/lib/slskd/vpn-agent/systemd/slskdN-vpn-ingress.service debian/slskdn/lib/systemd/system/slskdN-vpn-ingress.service; \
		install -Dm644 usr/lib/slskd/vpn-agent/systemd/slskdN-vpn-ingress-renew.service debian/slskdn/lib/systemd/system/slskdN-vpn-ingress-renew.service; \
		install -Dm644 usr/lib/slskd/vpn-agent/systemd/slskdN-vpn-ingress-renew.timer debian/slskdn/lib/systemd/system/slskdN-vpn-ingress-renew.timer; \
		install -Dm644 usr/lib/slskd/vpn-agent/systemd/slskdN-vpn-gluetun-compat.service debian/slskdn/lib/systemd/system/slskdN-vpn-gluetun-compat.service; \
		install -Dm644 usr/lib/slskd/vpn-agent/systemd/slskdN-vpn-watchdog.service debian/slskdn/lib/systemd/system/slskdN-vpn-watchdog.service; \
		install -Dm644 usr/lib/slskd/vpn-agent/systemd/slskdN-vpn-watchdog.timer debian/slskdn/lib/systemd/system/slskdN-vpn-watchdog.timer; \
	fi
	
	# Install config
	install -Dm644 etc/slskd/slskd.yml debian/slskdn/etc/slskd/slskd.yml
	
	# Install sysusers
	install -Dm644 usr/lib/sysusers.d/slskd.conf debian/slskdn/usr/lib/sysusers.d/slskd.conf

	# Install tmpfiles rules
	install -Dm644 usr/lib/tmpfiles.d/slskd.conf debian/slskdn/usr/lib/tmpfiles.d/slskd.conf
	install -dm755 debian/slskdn/var/lib/slskdN-vpn

override_dh_strip:
	# Don't strip .NET binaries

override_dh_shlibdeps:
	@echo "Skipping shlibdeps for bundled .NET runtime"
