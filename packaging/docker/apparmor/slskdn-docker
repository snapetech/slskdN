# AppArmor profile for hardened Docker deployments of slskdN.
#
# Load on an AppArmor-enabled Docker host with:
#   sudo apparmor_parser -r packaging/docker/apparmor/slskdn-docker
#
# Then run the container with:
#   --security-opt apparmor=slskdn-docker

#include <tunables/global>

profile slskdn-docker flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/openssl>

  capability net_bind_service,

  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,

  deny mount,
  deny remount,
  deny umount,
  deny ptrace,
  deny signal,

  deny /boot/** rwklx,
  deny /dev/mem rwklx,
  deny /dev/kmem rwklx,
  deny /proc/kcore rwklx,
  deny /proc/sysrq-trigger rwklx,
  deny /sys/** rwklx,

  / r,
  /etc/** r,
  /usr/** r,
  /lib/** r,
  /lib64/** r,
  /bin/** r,
  /sbin/** r,
  /slskd/** r,
  /slskd/slskd ix,

  /proc/ r,
  /proc/** r,
  /proc/self/** r,
  /proc/thread-self/** r,
  /proc/sys/kernel/random/boot_id r,
  /sys/devices/system/cpu/** r,

  /dev/null rw,
  /dev/zero r,
  /dev/full rw,
  /dev/random r,
  /dev/urandom r,
  /dev/tty rw,
  /dev/pts/** rw,

  /tmp/ rw,
  /tmp/** rwkl,
  /run/ rw,
  /run/** rwkl,
  /.net/ rw,
  /.net/** rwkl,

  /app/ rw,
  /app/** rwkl,
  /downloads/ rw,
  /downloads/** rwkl,
  /incomplete/ rw,
  /incomplete/** rwkl,
  /shares/ r,
  /shares/** r,

  /etc/slskd/slskd.yml r,
  /var/lib/slskd/ rw,
  /var/lib/slskd/** rwkl,
  /mnt/** r,

  owner @{HOME}/.local/share/slskd/ rw,
  owner @{HOME}/.local/share/slskd/** rwkl,
  owner @{HOME}/.config/slskd/ r,
  owner @{HOME}/.config/slskd/** r,
}
