#!/usr/bin/env bash
set -euo pipefail

show_help() {
  cat <<'EOF'
Install optional heavyweight SongID media tools into a running slskdN Docker
container or derived image.

Usage:
  install-optional-media-tools [profile ...]

Profiles:
  distro      Install distro-packaged prerequisites: Java, Python venv support,
              Tesseract OCR, build tools, Rust/Cargo, and Git.
  ai-python   Install Python tools into /opt/slskdn-media-tools/python:
              openai-whisper and demucs.
  c2pa        Install c2patool with Cargo into /usr/local/bin.
  songrec     Install SongRec with Cargo into /usr/local/bin.
  audfprint   Clone audfprint into /opt/slskdn-media-tools/audfprint and expose
              audfprint.py on PATH.
  panako      Install panako.jar to /usr/local/share/java/panako.jar. Downloads
              PANAKO_JAR_URL when set; otherwise builds JorenSix/Panako.
  all         Install distro, ai-python, c2pa, songrec, audfprint, and panako.

Environment:
  SLSKDN_MEDIA_TOOLS_ROOT       Default: /opt/slskdn-media-tools
  SLSKDN_PIP_PACKAGES           Default: openai-whisper demucs
  SLSKDN_C2PATOOL_CRATE_VERSION Default: empty, installs latest c2patool
  SLSKDN_SONGREC_CRATE_VERSION  Default: empty, installs latest songrec
  SLSKDN_RUST_TOOLCHAIN         Default: stable, used for SongRec
  AUDFPRINT_REPO                Default: https://github.com/dpwe/audfprint.git
  AUDFPRINT_REF                 Default: master
  PANAKO_JAR_URL                Optional direct jar URL for panako profile
  PANAKO_REPO                   Default: https://github.com/JorenSix/Panako.git
  PANAKO_REF                    Default: master
  SLSKDN_KEEP_PACKAGE_CACHES    Default: false. Set to true in derived Docker
                                 builds that use BuildKit cache mounts.

Examples:
  docker exec -u root slskd install-optional-media-tools distro ai-python
  docker exec -u root -e PANAKO_JAR_URL=https://example.invalid/panako.jar slskd \
    install-optional-media-tools panako
EOF
}

if [[ ${1:-} == "--help" || ${1:-} == "-h" ]]; then
  show_help
  exit 0
fi

if [[ "$(id -u)" != "0" ]]; then
  echo "install-optional-media-tools must run as root inside the container." >&2
  exit 1
fi

if [[ $# -eq 0 ]]; then
  set -- distro ai-python
fi

TOOLS_ROOT="${SLSKDN_MEDIA_TOOLS_ROOT:-/opt/slskdn-media-tools}"
PYTHON_VENV="${TOOLS_ROOT}/python"
BIN_DIR="/usr/local/bin"
JAVA_DIR="/usr/local/share/java"
APT_BASE_INSTALLED=0

keep_package_caches() {
  [[ "${SLSKDN_KEEP_PACKAGE_CACHES:-false}" =~ ^([Tt][Rr][Uu][Ee]|1|[Yy][Ee][Ss])$ ]]
}

apt_install_base() {
  if [[ "${APT_BASE_INSTALLED}" == "1" ]]; then
    return
  fi

  export DEBIAN_FRONTEND=noninteractive
  if keep_package_caches; then
    rm -f /etc/apt/apt.conf.d/docker-clean
  fi

  apt-get update
  apt-get install --no-install-recommends -y \
    build-essential \
    cargo \
    curl \
    git \
    intltool \
    libasound2-dev \
    libadwaita-1-dev \
    libclang-dev \
    libdbus-1-dev \
    libglib2.0-dev \
    libgtk-4-dev \
    libpipewire-0.3-dev \
    libpulse-dev \
    libsoup-3.0-dev \
    libssl-dev \
    openjdk-17-jdk-headless \
    openjdk-21-jre-headless \
    pkg-config \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    rustc \
    tesseract-ocr
  APT_BASE_INSTALLED=1

  if ! keep_package_caches; then
    rm -rf /var/lib/apt/lists/* /var/cache/apt/*
  fi
}

install_rustup_toolchain() {
  mkdir -p "${TOOLS_ROOT}/rustup" "${TOOLS_ROOT}/rustup-cargo"
  export RUSTUP_HOME="${TOOLS_ROOT}/rustup"
  export CARGO_HOME="${TOOLS_ROOT}/rustup-cargo"
  export CARGO_TARGET_DIR="${TOOLS_ROOT}/cargo-target"
  if [[ ! -x "${CARGO_HOME}/bin/cargo" ]]; then
    curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs \
      | sh -s -- -y --no-modify-path --profile minimal --default-toolchain "${SLSKDN_RUST_TOOLCHAIN:-stable}"
  fi
  export PATH="${CARGO_HOME}/bin:${PATH}"
}

install_ai_python() {
  apt_install_base
  mkdir -p "${TOOLS_ROOT}"
  python3 -m venv "${PYTHON_VENV}"
  "${PYTHON_VENV}/bin/python" -m pip install --upgrade pip setuptools wheel
  # Intentionally unpinned by default: these stacks move quickly and operators
  # can override the exact set with SLSKDN_PIP_PACKAGES in a derived image.
  "${PYTHON_VENV}/bin/pip" install ${SLSKDN_PIP_PACKAGES:-openai-whisper demucs}
  ln -sf "${PYTHON_VENV}/bin/whisper" "${BIN_DIR}/whisper"
  ln -sf "${PYTHON_VENV}/bin/demucs" "${BIN_DIR}/demucs"
}

install_c2pa() {
  apt_install_base
  install_rustup_toolchain
  mkdir -p "${TOOLS_ROOT}/c2pa-bin"
  local crate_version_args=()
  if [[ -n "${SLSKDN_C2PATOOL_CRATE_VERSION:-}" ]]; then
    crate_version_args=(--version "${SLSKDN_C2PATOOL_CRATE_VERSION}")
  fi
  cargo install c2patool "${crate_version_args[@]}" --root "${TOOLS_ROOT}/c2pa-bin"
  ln -sf "${TOOLS_ROOT}/c2pa-bin/bin/c2patool" "${BIN_DIR}/c2patool"
}

install_songrec() {
  apt_install_base
  install_rustup_toolchain
  mkdir -p "${TOOLS_ROOT}/songrec-bin"
  local crate_version_args=()
  if [[ -n "${SLSKDN_SONGREC_CRATE_VERSION:-}" ]]; then
    crate_version_args=(--version "${SLSKDN_SONGREC_CRATE_VERSION}")
  fi
  cargo install songrec "${crate_version_args[@]}" --no-default-features --root "${TOOLS_ROOT}/songrec-bin"
  ln -sf "${TOOLS_ROOT}/songrec-bin/bin/songrec" "${BIN_DIR}/songrec"
}

install_audfprint() {
  apt_install_base
  local repo="${AUDFPRINT_REPO:-https://github.com/dpwe/audfprint.git}"
  local ref="${AUDFPRINT_REF:-master}"
  local target="${TOOLS_ROOT}/audfprint"
  rm -rf "${target}"
  git clone --depth 1 --branch "${ref}" "${repo}" "${target}"
  chmod +x "${target}/audfprint.py"
  ln -sf "${target}/audfprint.py" "${BIN_DIR}/audfprint.py"
}

install_panako() {
  apt_install_base
  mkdir -p "${JAVA_DIR}"
  if [[ -n "${PANAKO_JAR_URL:-}" ]]; then
    wget -q -O "${JAVA_DIR}/panako.jar" "${PANAKO_JAR_URL}"
  else
    local repo="${PANAKO_REPO:-https://github.com/JorenSix/Panako.git}"
    local ref="${PANAKO_REF:-master}"
    local target="${TOOLS_ROOT}/panako-src"
    rm -rf "${target}"
    git clone --depth 1 --branch "${ref}" "${repo}" "${target}"
    (cd "${target}" && JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 ./gradlew --no-daemon shadowJar)
    local jar
    jar="$(find "${target}/build/libs" -maxdepth 1 -type f \( -name '*-all.jar' -o -name 'panako.jar' \) | sort | tail -n 1)"
    if [[ -z "${jar}" ]]; then
      echo "Panako build completed but no runnable jar was found in ${target}/build/libs." >&2
      exit 1
    fi
    cp "${jar}" "${JAVA_DIR}/panako.jar"
  fi
  chmod 0644 "${JAVA_DIR}/panako.jar"
}

run_profile() {
  case "$1" in
    distro)
      apt_install_base
      ;;
    ai-python)
      install_ai_python
      ;;
    c2pa)
      install_c2pa
      ;;
    songrec)
      install_songrec
      ;;
    audfprint)
      install_audfprint
      ;;
    panako)
      install_panako
      ;;
    all)
      install_ai_python
      install_c2pa
      install_songrec
      install_audfprint
      install_panako
      ;;
    *)
      echo "Unknown optional media tool profile: $1" >&2
      show_help >&2
      exit 1
      ;;
  esac
}

for profile in "$@"; do
  run_profile "${profile}"
done

find / -xdev -type f \( -perm -4000 -o -perm -2000 \) -exec chmod a-s {} +
rm -rf /tmp/* /var/tmp/*

if ! keep_package_caches; then
  rm -rf /root/.cache /root/.cargo/registry /root/.cargo/git
fi

echo "Optional media tool installation complete."
