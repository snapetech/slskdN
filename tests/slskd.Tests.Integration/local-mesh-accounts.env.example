# Copy this to local-mesh-accounts.env and keep that file private.
# These are optional real-network mesh smoke credentials, not required for the deterministic two-node local smoke.
SLSKDN_MESH_ACCOUNT_A_USERNAME=
SLSKDN_MESH_ACCOUNT_A_PASSWORD=
SLSKDN_MESH_ACCOUNT_B_USERNAME=
SLSKDN_MESH_ACCOUNT_B_PASSWORD=

# Optional local rotation pool. The live mesh smoke uses the first two complete
# accounts it finds, so add more entries here or in local-mesh-account-pool.env
# when one pair is busy or blocked by same-IP concurrency limits.
SLSKDN_MESH_ACCOUNT_C_USERNAME=
SLSKDN_MESH_ACCOUNT_C_PASSWORD=
SLSKDN_MESH_ACCOUNT_D_USERNAME=
SLSKDN_MESH_ACCOUNT_D_PASSWORD=

# Numbered entries are also accepted.
SLSKDN_MESH_ACCOUNT_1_USERNAME=
SLSKDN_MESH_ACCOUNT_1_PASSWORD=
SLSKDN_MESH_ACCOUNT_2_USERNAME=
SLSKDN_MESH_ACCOUNT_2_PASSWORD=
