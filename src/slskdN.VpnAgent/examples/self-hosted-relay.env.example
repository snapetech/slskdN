SLSKDN_RELAY_WG_IFACE=slskdN-relay
SLSKDN_RELAY_PUBLIC_IFACE=eth0
SLSKDN_RELAY_TUNNEL_CIDR=10.77.0.0/30
SLSKDN_RELAY_HOME_IP=10.77.0.2
SLSKDN_RELAY_PUBLIC_PORT=50300
SLSKDN_RELAY_TARGET_PORT=50300
SLSKDN_RELAY_API_HOST=10.77.0.1
SLSKDN_RELAY_API_PORT=8010
SLSKDN_RELAY_API_KEY_FILE=/etc/slskdN-relay/api-keys
SLSKDN_RELAY_CONNECTION_LIMIT=128
SLSKDN_RELAY_BANDWIDTH_MBIT=100
SLSKDN_RELAY_HANDSHAKE_MAX_AGE=180
# Set this when outbound HTTP discovery is unavailable:
# SLSKDN_RELAY_PUBLIC_IP=203.0.113.10
