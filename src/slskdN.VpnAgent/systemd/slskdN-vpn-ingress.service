[Unit]
Description=Transparent VPN ingress forwards for slskdN listener ports
After=network-online.target slskdN.service
Wants=network-online.target slskdN.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/slskdN-vpn-agent
Environment=PF_ATTEMPTS=90
Environment=PF_LIFETIME=60
ExecStart=/usr/local/bin/slskdN-vpn-agent ingress
ExecStop=/usr/local/bin/slskdN-vpn-agent cleanup-ingress
TimeoutStartSec=20min
NoNewPrivileges=true
# ip netns add creates namespace bind mounts under /run/netns. Filesystem
# sandboxing creates a private mount namespace for this unit, which leaves
# dead placeholder files on the host after the oneshot exits.
ProtectHome=false

[Install]
WantedBy=multi-user.target
