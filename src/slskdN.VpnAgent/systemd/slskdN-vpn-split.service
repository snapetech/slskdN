[Unit]
Description=Route slskdN service UID through the configured VPN interface
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/slskdN-vpn-agent
ExecStart=/usr/local/bin/slskdN-vpn-agent split
RemainAfterExit=yes
NoNewPrivileges=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
