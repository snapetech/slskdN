[Unit]
Description=Check slskdN VPN health and recover ingress mapping
After=slskdN.service slskdN-vpn-ingress.service slskdN-vpn-gluetun-compat.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/slskdN-vpn-agent
ExecStart=/usr/local/bin/slskdN-vpn-agent watchdog
TimeoutStartSec=45s
NoNewPrivileges=true
ProtectHome=true
ReadWritePaths=/var/lib/slskdN-vpn
